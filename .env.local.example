# Supabase — medsafe-cloud project
# Dashboard: https://supabase.com/dashboard/project/woisxvgsgvpfnntmrpat

NEXT_PUBLIC_SUPABASE_URL=https://woisxvgsgvpfnntmrpat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Local dev URL (used as OAuth redirect fallback)
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Set to "true" to allow /signup and OAuth registration (default: login only)
# SIGNUP_ENABLED=true

# Google/Apple login for existing users (default: enabled)
# OAUTH_LOGIN_ENABLED=false

# Google Web Client ID (same as in Supabase Google provider settings)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Set to "true" only after Apple OAuth is configured in Supabase
# NEXT_PUBLIC_ENABLE_APPLE_OAUTH=true

# --- AARYX Market Intelligence (server-side only — never use NEXT_PUBLIC_ prefix) ---

# Provider: "mock" (default) | "polygon"
# MARKET_DATA_PROVIDER=polygon

# Polygon.io API key — required for live WTI/Brent futures data
# MARKET_DATA_API_KEY=your-polygon-api-key

# Optional Polygon endpoints (defaults shown)
# MARKET_DATA_REST_URL=https://api.polygon.io
# MARKET_DATA_WEBSOCKET_URL=wss://socket.polygon.io
# MARKET_DATA_WEBSOCKET_ENABLED=true
# MARKET_POLL_INTERVAL_MS=5000

# OpenAI API key — required for live AI analysis (Phase 4+)
# OPENAI_API_KEY=your-openai-api-key

# --- AARYX News Intelligence (server-side only) ---

# Provider: "development" (default) | "newsapi"
# NEWS_DATA_PROVIDER=newsapi

# NewsAPI.org key — https://newsapi.org
# NEWS_API_KEY=your-newsapi-key

# Optional
# NEWS_API_BASE_URL=https://newsapi.org/v2
# NEWS_POLL_INTERVAL_MS=30000

# --- AARYX AI Intelligence (server-side only) ---

# Provider: "deterministic" (default) | "demo" | "openai"
# AI_PROVIDER=openai

# OpenAI or compatible API key
# AI_API_KEY=your-openai-api-key
# Or reuse: OPENAI_API_KEY=your-openai-api-key

# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2
# AI_DEBOUNCE_MS=5000

# --- AARYX Phase 6: 24/7 Operations & Alerting (server-side only) ---

# Master switches
# ALERT_DELIVERY_ENABLED=true
# BACKGROUND_WORKERS_ENABLED=true
# MARKET_MONITORING_ENABLED=true
# NEWS_MONITORING_ENABLED=true
# AI_ANALYSIS_ENABLED=true

# Telegram (server-side only — never NEXT_PUBLIC_)
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id
# TELEGRAM_MIN_SEVERITY=HIGH

# Web Push (Phase 6 prep — full delivery in Phase 7)
# WEB_PUSH_ENABLED=false

# Worker / cron auth (required in production)
# WORKER_SECRET=your-random-secret
# Or reuse Vercel cron secret:
# CRON_SECRET=your-random-secret

# Alert tuning
# ALERT_COOLDOWN_MS=300000
# WORKER_HEARTBEAT_STALE_MS=120000
# WORKER_TICK_INTERVAL_MS=5000

# For standalone 24/7 worker: npx tsx scripts/aaryx-worker.ts

# Supabase service role — AARYX persistence only (never NEXT_PUBLIC_, never client-side)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# MI_DB_PASSWORD=your-database-password
# MI_PERSISTENCE_ENABLED=true
# WORKER_INSTANCE_ID=aaryx-worker-1

# One-shot setup after adding keys above:
# npm run mi:setup
