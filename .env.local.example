# Supabase — https://supabase.com/dashboard/project/woisxvgsgvpfnntmrpat
NEXT_PUBLIC_SUPABASE_URL=https://woisxvgsgvpfnntmrpat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
MI_PERSISTENCE_ENABLED=true

# Local dev URL — must match npm run dev port
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Temporary open access (guest button + new Google accounts allowed)
# OPEN_ACCESS_ENABLED=false
# GUEST_EMAIL=guest@aaryx.app
# GUEST_PASSWORD=aaryx-guest-open
# OAUTH_LOGIN_ENABLED=true
# SIGNUP_ENABLED=false

# --- Marktkurse — Yahoo Finance (kein Polygon / OilPriceAPI nötig) ---
MARKET_DATA_PROVIDER=composite
MARKET_QUOTE_STYLE=investing
MARKET_POLL_INTERVAL_MS=2000
# Optional Spot-Öl-Fallback:
# OILPRICEAPI_KEY=your-oilpriceapi-key
# OILPRICEAPI_AS_FALLBACK=true
# Optional Polygon:
# MARKET_DATA_API_KEY=your-polygon-api-key
# POLYGON_AS_FALLBACK=true

# --- News (Free Oil RSS — kein bezahltes API nötig) ---
NEWS_DATA_PROVIDER=oil-rss
NEWS_API_AS_SECONDARY=false
NEWS_POLL_INTERVAL_MS=60000
# Optional: NEWS_API_KEY=... NEWS_API_BASE_URL=https://newsapi.org/v2

# --- KI (OpenAI) ---
# https://platform.openai.com/api-keys
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_DEBOUNCE_MS=5000

# --- 24/7 Operations ---
ALERT_DELIVERY_ENABLED=true
BACKGROUND_WORKERS_ENABLED=true
MARKET_MONITORING_ENABLED=true
NEWS_MONITORING_ENABLED=true
AI_ANALYSIS_ENABLED=true
WORKER_SECRET=generate-with-openssl-rand-hex-32
CRON_SECRET=same-as-worker-secret-or-different
WORKER_TICK_INTERVAL_MS=15000
WORKER_HEARTBEAT_STALE_MS=120000
ALERT_COOLDOWN_MS=300000
WORKER_INSTANCE_ID=aaryx-worker-1

# --- Telegram (optional) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=HIGH

WEB_PUSH_ENABLED=false

# Go-live: npm run mi:live-check
# Worker:  npm run mi:worker
# Verify:  npm run mi:verify
